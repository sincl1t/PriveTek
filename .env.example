# Set locally; never publish real credentials. Render environment overrides this file.
WEBHOOK_SECRET=
STATUS_API_KEY=
DATABASE_URL=
REQUIRE_DATABASE=false
MAIL_PROVIDER=brevo
BREVO_API_KEY=
MAIL_FROM=privetekmail@gmail.com
HIBP_API_KEY=
HOST=127.0.0.1
PORT=8000
# Alternative mail transport:
# MAIL_PROVIDER=smtp
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURITY=starttls
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=

# User account: leave disabled until the database/mail/keys are configured.
ACCOUNTS_ENABLED=false
ACCOUNT_ORIGIN=https://privetek.onrender.com
# Independent random secret of 32+ characters; changing it breaks owner mappings/sessions.
ACCOUNT_SECRET=
# Fernet key; generate with Fernet.generate_key(), keep a secure backup.
ACCOUNT_REPORT_KEY=

# Stage 5: optional model selection of grounded summary facts; disabled by default.
AI_SUMMARY_ENABLED=false
AI_DATA_TRANSFER_APPROVED=false
OPENAI_API_KEY=
AI_SUMMARY_MODEL=
# Explicit shared hourly request cap; 0 disables calls. Configure provider spend limits too.
AI_MAX_CALLS_PER_HOUR=0

# Weekly opt-in monitoring pilot. Enable only after deploying the scheduler.
MONITOR_ENABLED=false
MONITOR_RUNNER_TOKEN=
